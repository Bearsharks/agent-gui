{
  "name": "@agent-gui/preview-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-gui-preview": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/preview-runtime.css dist/preview-runtime.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck"
  },
  "dependencies": {
    "react": "^19.2.6",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14"
  }
}
